{
  "name": "confirmlayer-site",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist"
  },
  "build": {
    "command": "mkdir -p dist && cp index.html dist/ && cp -R assets dist/"
  },
  "routes": [
    { "pattern": "confirmlayer.com", "custom_domain": true },
    { "pattern": "*.confirmlayer.com/*", "zone_name": "confirmlayer.com" }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
